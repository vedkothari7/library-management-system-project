# Athena LMS - Environment Configuration Example
# Copy this file to .env or set variables in your cloud hosting provider dashboard.

# Application Environment: 'development' or 'production'
APP_ENV=development

# Mandatory in production: Cryptographically strong secret key (min 32 bytes)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-very-long-random-secret-key-32-bytes

# Cookie Security: Set to 'true' in production when HTTPS is enabled
SESSION_COOKIE_SECURE=false

# SQLite Database Location:
# Defaults to 'library.db' in the project directory.
# In cloud deployments with persistent disks (e.g. Render /var/data/library.db), specify the absolute path:
DATABASE_PATH=library.db

# Reverse Proxy Configuration:
# Set to the number of trusted upstream reverse proxies (e.g. 1 for Render / Heroku / Nginx).
# Default is 0 (direct connection / localhost, ProxyFix disabled to prevent IP spoofing).
PROXIES_COUNT=0

# Server Binding (used by python app.py or wsgi.py)
PORT=5000
HOST=127.0.0.1
